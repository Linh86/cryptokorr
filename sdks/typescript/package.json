{
  "name": "@cryptokorr/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the CryptoKorr /v1 control-plane API (intents, decisions, approvals, audit, runtime).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "license": "MIT",
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Linh86/cryptokorr",
    "directory": "sdks/typescript"
  },
  "homepage": "https://github.com/Linh86/cryptokorr/tree/main/sdks/typescript#readme",
  "bugs": "https://github.com/Linh86/cryptokorr/issues",
  "keywords": [
    "cryptokorr",
    "sdk",
    "treasury",
    "agent",
    "base-sepolia"
  ]
}
