# Copy to .env.staging and fill in real values before running docker compose.
# Never commit the filled-in file — .gitignore already excludes .env.*.

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=bank
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bank_staging

# --- Phoenix ---------------------------------------------------------------
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=
PHX_HOST=staging.bank.internal

# --- Adapter ---------------------------------------------------------------
# REQUIRED in production — Phoenix raises on boot if any of these is
# missing (see config/runtime.exs). The two secrets gate the two
# directions of the trust boundary independently:
#
#   * ADAPTER_DISPATCH_SECRET — bearer Phoenix sends on outbound
#     POST /dispatch/* and the adapter validates.
#   * ADAPTER_CALLBACK_SECRET — bearer the adapter sends on inbound
#     POST /internal/adapter/callback and Phoenix validates.
#
# Generate each with `openssl rand -hex 32` and provision matching
# values to both services. Rotate independently on a leak.
ADAPTER_DISPATCH_SECRET=
ADAPTER_CALLBACK_SECRET=
# Internal DNS name from docker-compose. In cloud staging this is the
# adapter's private service URL.
ADAPTER_BASE_URL=http://adapter:3000
# Override with the published adapter image once available.
ADAPTER_IMAGE=ghcr.io/cryptobank/adapter:placeholder

# --- Chain / bundler (adapter-side) ----------------------------------------
CHAIN=base-sepolia
BUNDLER_URL=
