<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>{assigns[:page_title] || "Pending access"} — CryptoKorr</title>
    <link rel="stylesheet" href={~p"/assets/app.css"} />
  </head>
  <body class="min-h-screen bg-base-100 text-base-content">
    <main id="pending-main" class="flex min-h-screen items-center justify-center p-6">
      <div class="w-full max-w-md space-y-6 rounded-xl border border-base-300 bg-base-200 p-8">
        <header class="space-y-2">
          <p class="text-xs uppercase tracking-widest text-base-content/50">
            Private alpha
          </p>
          <h1 id="pending-heading" class="text-2xl font-semibold tracking-tight">
            Access pending
          </h1>
        </header>

        <%= case assigns[:pending_classification] do %>
          <% :domain_match -> %>
            <section id="pending-status-domain-match" class="space-y-3">
              <p class="text-sm leading-relaxed">
                Your organization
                <%= if @pending_invite && @pending_invite.domain do %>
                  (<span class="font-mono">{@pending_invite.domain}</span>)
                <% end %>
                is on the allowlist. An admin will activate your access shortly.
              </p>
              <p class="text-xs text-base-content/60">
                You don't need to do anything — once an operator approves your
                request you'll see the app on your next sign-in.
              </p>
            </section>
          <% :allowlist_missed -> %>
            <section id="pending-status-no-invite" class="space-y-3">
              <p class="text-sm leading-relaxed">
                We don't have an invite for your address yet. CryptoKorr is
                invite-only during private alpha.
              </p>
              <p class="text-xs text-base-content/60">
                If this is your first time signing in, please ask the team to
                add you to the allowlist.
              </p>
            </section>
          <% :ambiguous -> %>
            <section id="pending-status-ambiguous" class="space-y-3">
              <p class="text-sm leading-relaxed">
                You belong to more than one workspace. A workspace picker is
                coming in a future release; in the meantime an operator can
                point you at a specific workspace.
              </p>
            </section>
          <% :exact_match_pending -> %>
            <section id="pending-status-exact-match" class="space-y-3">
              <p class="text-sm leading-relaxed">
                You have a pending invite. We're finalising your workspace
                access — try refreshing the page in a moment.
              </p>
            </section>
          <% _ -> %>
            <section id="pending-status-default" class="space-y-3">
              <p class="text-sm leading-relaxed">
                We received your sign-in. CryptoKorr is invite-only during
                private alpha — an operator will review your account and
                grant workspace access.
              </p>
              <p class="text-xs text-base-content/60">
                You'll see the app once an admin approves your access. No
                chain actions, intent submissions, or workspace data are
                available before then.
              </p>
            </section>
        <% end %>

        <%= if @current_user do %>
          <div class="rounded-md bg-base-100 p-3 text-xs">
            Signed in as <span class="font-medium">{@current_user.email}</span>
          </div>
        <% end %>

        <form action={~p"/logout"} method="post" id="logout-form">
          <input type="hidden" name="_method" value="delete" />
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <button type="submit" id="logout-button" class="text-sm underline hover:no-underline">
            Sign out
          </button>
        </form>
      </div>
    </main>
  </body>
</html>
