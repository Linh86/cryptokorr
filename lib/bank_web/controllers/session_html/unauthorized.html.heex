<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>{assigns[:page_title] || "Insufficient permissions"} — CryptoBank</title>
    <link rel="stylesheet" href={~p"/assets/app.css"} />
  </head>
  <body class="min-h-screen bg-base-100 text-base-content">
    <main id="unauthorized-main" class="flex min-h-screen items-center justify-center p-6">
      <div class="w-full max-w-md space-y-6 rounded-xl border border-base-300 bg-base-200 p-8">
        <header class="space-y-2">
          <p class="text-xs uppercase tracking-widest text-base-content/50">
            Access denied
          </p>
          <h1 id="unauthorized-heading" class="text-2xl font-semibold tracking-tight">
            You don't have permission to view this page
          </h1>
        </header>

        <section class="space-y-3">
          <p class="text-sm leading-relaxed">
            Your workspace membership doesn't grant the role required for
            this surface. Ask your workspace admin to upgrade your role if
            you need ongoing access.
          </p>
          <p class="text-xs text-base-content/60">
            Roles, in increasing authority: <span class="font-mono">viewer</span>, <span class="font-mono">operator</span>, <span class="font-mono">admin</span>, <span class="font-mono">owner</span>.
          </p>
        </section>

        <nav class="flex flex-col gap-2">
          <.link
            href={~p"/"}
            class="btn btn-primary btn-sm"
          >
            Back to dashboard
          </.link>
          <.link
            href={~p"/logout"}
            method="delete"
            class="btn btn-ghost btn-sm"
          >
            Sign out
          </.link>
        </nav>
      </div>
    </main>
  </body>
</html>
